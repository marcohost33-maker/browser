# Preserve LF so the committed bytes stay identical to the delivered files and
# their hashes in results/sha256.txt remain reproducible (repo has known CRLF traps).
* text=auto eol=lf
*.py text eol=lf
*.mjs text eol=lf
*.rs text eol=lf
*.md text eol=lf
*.json text eol=lf
*.txt text eol=lf

# External RFC 8785/JCS oracle vectors: byte-exact ground truth — git must NEVER
# normalize these (eol/whitespace changes would corrupt the oracle).
testdata-rfc8785/** -text
